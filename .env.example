# CoreSpec runs with NO environment variables. Everything below is optional.
# Put real values in .env.local (local) or Vercel → Settings → Environment Variables.
# Never commit real values.

# Error reporting (Sentry). Leave empty to keep it switched off.
# The DSN is public by design (it can only send events), so NEXT_PUBLIC_ is fine.
NEXT_PUBLIC_SENTRY_DSN=

# Source-map upload for readable Sentry stack traces. SECRET: build-time only,
# set it in Vercel, never with a NEXT_PUBLIC_ prefix.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set automatically by Vercel; listed so you know they exist.
# VERCEL_PROJECT_PRODUCTION_URL=
# NEXT_PUBLIC_VERCEL_ENV=

# Accounts (Phase 16, Supabase). Leave both empty and the site has no login at all,
# exactly as before. Both are public by design (Row Level Security protects the
# data), so NEXT_PUBLIC_ is right. Set them for Vercel's Preview environment
# only until accounts should go live. There is NO service-role key: never add one.
# Supabase dashboard → Project Settings → API (URL) and API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "on" only once a real email sender is set up (docs/accounts.md): shows
# "Forgot password?". Default off.
NEXT_PUBLIC_AUTH_EMAIL=
